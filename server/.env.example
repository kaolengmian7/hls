# Copy this file to .env before running docker compose.

HLS_SERVER_PORT=8088
HLS_MODE=prod

# Use a long random value in production.
HLS_SESSION_SECRET=replace-with-a-long-random-secret
HLS_SESSION_TTL_MINUTES=1440

# Comma-separated browser origins allowed by HTTP CORS and WebSocket origin checks.
HLS_CORS_ALLOW_ORIGINS=https://hls-club.com
